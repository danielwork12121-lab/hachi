# Volcengine Ark (Doubao) credentials. NEVER commit a real key.
# The whole reason this service exists is to keep this key off the client:
# anything bundled into the React Native app can be extracted from the app.
DOUBAO_API_KEY=your-ark-api-key-here
DOUBAO_MODEL_ID=your-ark-endpoint-or-model-id
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Request handling
LLM_TIMEOUT_MS=20000
PORT=8787
