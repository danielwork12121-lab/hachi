{
  "expo": {
    "name": "Hachi",
    "slug": "pet-bazi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f1729"
    },
    "assetBundlePatterns": ["**/*"],
    "web": {
